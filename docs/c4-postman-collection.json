        {
          "name": "POST - Crear intervencion (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Location header presente\", function () {",
                  "    pm.response.to.have.header(\"Location\");",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.test(\"status inicial es PLANNED\", function () {",
                  "        pm.expect(body.status).to.eql(\"PLANNED\");",
                  "    });",
                  "    pm.collectionVariables.set(\"interventionId\", body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"TUTORING\",\n  \"description\": \"Tutoria de refuerzo en matematica\",\n  \"responsible\": \"Lic. Ana Perez\",\n  \"startDate\": \"2026-09-20\"\n}",
